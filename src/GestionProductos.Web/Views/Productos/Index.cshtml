@model ProductosIndexViewModel
@{ ViewData["Title"] = "Productos"; }
<div class="page-heading"><div><div class="eyebrow">INVENTARIO GENERAL</div><h1>Productos</h1><p>Administra tus productos, precios y existencias</p></div><a class="btn btn-primary btn-lg" asp-action="Crear">＋ Nuevo producto</a></div>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="summary-card"><div class="summary-icon blue">▦</div><div><div class="summary-label">Total de productos</div><div class="summary-value">@Model.TotalProductos</div></div></div></div>
    <div class="col-md-4"><div class="summary-card"><div class="summary-icon teal">▤</div><div><div class="summary-label">Total de unidades</div><div class="summary-value">@Model.TotalUnidades</div></div></div></div>
    <div class="col-md-4"><div class="summary-card"><div class="summary-icon green">Q</div><div><div class="summary-label">Valor de existencias</div><div class="summary-value">Q@(Model.ValorExistencias.ToString("N2"))</div></div></div></div>
</div>
<section class="panel"><div class="panel-heading"><div><h2>Listado de productos</h2><p>Consulta y administra tu inventario</p></div><form method="get" asp-action="Index" class="search-form"><label class="visually-hidden" for="busqueda">Buscar producto</label><input id="busqueda" name="busqueda" class="form-control" value="@Model.Busqueda" placeholder="Buscar por nombre o ID" /><button class="btn btn-outline-primary" type="submit">⌕ Buscar</button></form></div>
@if (Model.Productos.Count == 0)
{
    <div class="empty-state"><div class="empty-icon">▦</div><h3>@(string.IsNullOrWhiteSpace(Model.Busqueda) ? "Aún no hay productos" : "No se encontraron resultados")</h3><p>@(string.IsNullOrWhiteSpace(Model.Busqueda) ? "Registra tu primer producto para empezar a gestionar el inventario." : "Prueba con otro nombre o identificador.")</p>@if (string.IsNullOrWhiteSpace(Model.Busqueda)) { <a asp-action="Crear" class="btn btn-primary">＋ Registrar primer producto</a> } else { <a asp-action="Index" class="btn btn-outline-primary">Ver todos</a> }</div>
}
else
{
    <div class="table-responsive"><table class="table product-table align-middle mb-0"><thead><tr><th>ID</th><th>Nombre</th><th>Precio</th><th>Cantidad</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach (var p in Model.Productos) { <tr><td class="muted-id">#@p.Id</td><td><strong>@p.Nombre</strong></td><td>Q@(p.Precio.ToString("N2"))</td><td>@p.Cantidad</td><td><span class="status-pill @(p.Cantidad > 0 ? "available" : "unavailable")">@(p.Cantidad > 0 ? "Disponible" : "Sin existencias")</span></td><td class="actions"><a asp-action="Detalle" asp-route-id="@p.Id">◉ Ver</a><a asp-action="Editar" asp-route-id="@p.Id">✎ Editar</a><a class="danger-link" asp-action="Eliminar" asp-route-id="@p.Id">× Eliminar</a></td></tr> }</tbody></table></div>
}
</section>
