@model Producto
@{ ViewData["Title"] = "Detalle del producto"; }
<div class="page-heading"><div><div class="eyebrow">INVENTARIO / DETALLE</div><h1>Detalle del producto</h1><p>Información completa del registro #@Model.Id.</p></div></div>
<div class="panel detail-panel"><div class="panel-heading"><div><h2>@Model.Nombre</h2><p>Identificador #@Model.Id</p></div><span class="status-pill @(Model.Cantidad > 0 ? "available" : "unavailable")">@(Model.Cantidad > 0 ? "Disponible" : "Sin existencias")</span></div><div class="panel-body"><div class="detail-grid"><div><span>Precio unitario</span><strong>Q@(Model.Precio.ToString("N2"))</strong></div><div><span>Unidades disponibles</span><strong>@Model.Cantidad</strong></div><div><span>Valor en existencias</span><strong>Q@((Model.Precio * Model.Cantidad).ToString("N2"))</strong></div></div><div class="form-actions"><a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">✎ Editar producto</a><a asp-action="Index" class="btn btn-light">← Volver al listado</a></div></div></div>
