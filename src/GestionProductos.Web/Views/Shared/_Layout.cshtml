<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Gestión de Productos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" asp-append-version="true" href="~/css/site.css" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a asp-controller="Productos" asp-action="Index" class="brand"><span class="brand-mark">◆</span><span>Gestión de<br />Productos</span></a>
            <div class="nav-label">MENÚ PRINCIPAL</div>
            <a class="side-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Productos" asp-action="Index"><span aria-hidden="true">▦</span> Productos</a>
            <a class="side-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Inventario" ? "active" : "")" asp-controller="Productos" asp-action="Inventario"><span aria-hidden="true">▤</span> Inventario</a>
            <a class="side-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Crear" ? "active" : "")" asp-controller="Productos" asp-action="Crear"><span aria-hidden="true">＋</span> Nuevo producto</a>
            <div class="sidebar-foot">Panel de inventario<br /><small>Proyecto académico · .NET 9</small></div>
        </aside>
        <div class="main-area">
            <header class="topbar">
                <button class="menu-toggle" id="menuToggle" type="button" aria-controls="sidebar" aria-expanded="false" aria-label="Abrir menú">☰</button>
                <span class="topbar-title">Panel de inventario</span>
                <span class="topbar-badge">● Sistema activo</span>
            </header>
            <main class="content container-fluid">
                @if (TempData["Exito"] is string exito) { <div class="alert alert-success alert-dismissible fade show" role="alert">✓ @exito <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div> }
                @RenderBody()
            </main>
        </div>
    </div>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script asp-append-version="true" src="~/js/site.js"></script>
</body>
</html>
